# ===================================================
#  YOU FILL THESE IN
# ===================================================

# Active domain (this project ships one): datagov
DEMO_DOMAIN=datagov

# OpenAI
OPENAI_API_KEY=

# Redis Cloud database
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=false

# Context Surfaces (admin key from cloud console)
CTX_ADMIN_KEY=

# Agent Memory
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=

# LangCache
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# ===================================================
#  AUTO-POPULATED (by make setup)
# ===================================================

MCP_AGENT_KEY=
CTX_SURFACE_ID=
DEMO_USER_ID=
DEMO_USER_NAME=
DEMO_USER_EMAIL=

# ===================================================
#  DEFAULTS (change only if needed)
# ===================================================

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_USERNAME=default
REDIS_DB=0
# Optional override. When unset, all domains use 0.5 (0.7 missed natural-language lookups).
# MEMORY_SIMILARITY_THRESHOLD=0.5
MEMORY_LIMIT=6
LANGCACHE_THRESHOLD=0.9
# Semantic tool routing: send the LLM only the tools each question needs (saves tokens).
# Set to false to compare token usage with every tool attached.
TOOL_ROUTING_ENABLED=true
BACKEND_PORT=8040
FRONTEND_PORT=3040
